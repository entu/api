    "@sentry/node": "10.71.0",
    "@simplewebauthn/server": "13.3.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.9.1",
    "eslint-plugin-unicorn": "73.0.0",
    "graphql-yoga": "5.22.0",
    "jimp": "1.6.1",
    "jsonwebtoken": "9.0.3",
    "mongodb": "7.6.0",
    "mupdf": "1.28.0",
    "nitro": "3.0.0",
    "stripe": "22.5.0",
    "unstorage": "1.17.5"
